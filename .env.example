# Base de la API. En DEV se usa la ruta relativa "/api" y Vite proxiea a VITE_API_PROXY.
# En PRODUCCIÓN se pone la URL absoluta del backend, ej:
#   VITE_API_BASE=https://backend-ascensores-jessica-production.up.railway.app/api
VITE_API_BASE=/api

# Solo necesario en DEV: a dónde proxiear /api y /uploads desde el servidor de Vite.
VITE_API_PROXY=http://localhost:4000

# Opcional: base para archivos subidos (uploads). Si se omite, se deduce de VITE_API_BASE
# quitando el sufijo "/api". Útil si el backend sirve uploads desde otra URL.
# VITE_ASSETS_BASE=https://backend-ascensores-jessica-production.up.railway.app
